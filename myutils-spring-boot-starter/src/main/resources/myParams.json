//本默认配置优先级最低，用户端传参可以覆盖本配置
{
  //原对象，一般是前端的表单数据，与对应表字段对应
  "yobj": {
  },
  //系统参数
  "sys": {
    //执行操作;设置执行什么操作，默认getData，可选项：getData获取数据，plcl执行新增修改操作
    "zxcz": "getdata",
    //请求时清除缓存，默认false，重新加载对象、字段等信息
    "clearCache": false,
    //数据是否使用缓存，部分功能数据存在缓存会用到，默认true
    "dataCache": true
  },
  //分页对象
  "page": {
    //是否进行总数统计
    "totalRequired": true,
    //是否进行列表查询
    "listRequired": true,
    //查询页号
    "pageNumber": 1,
    //页大小
    "pageSize": 10
  }
}