### 字典项查询
POST {{serviceAddr}}
Content-Type: application/json

{
  "yobj": {
    "zdlb":"SYS_COMMON_ZDLB"
  },
  "page":{
    "totalRequired":true,
    "pageSize": 50
  },
  "sys":{
    "authCode": "QTQX_ZDGL",
    "cllx":"zdSearch",
    "token":"4978866291C611DA0D2D5999C413107F",
    "searchKey": "1"
  }
}

> {%
client.test("Request executed successfully", function() {
  client.assert(response.status === 200, "请求异常："+response.body);
});
%}

### 系统表搜索
POST {{serviceAddr}}
Content-Type: application/json

{
  "yobj": {
    "zdlb":"SYS_COMMON_TABLES",
    "ztlx": "oracle",
    "sjzt": "default",
    "owner": "SJSJ"
  },
  "page":{
    "totalRequired":true,
    "pageSize": 5
  },
  "sys":{
    "authCode": "QTQX_ZDGL",
    "cllx":"zdSearch",
    "token":"4978866291C611DA0D2D5999C413107F",
    "searchKey": "S"
  }
}

> {%
client.test("Request executed successfully", function() {
  client.assert(response.status === 200, "请求异常："+response.body);
