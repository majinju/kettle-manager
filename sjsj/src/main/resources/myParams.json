{
  //原对象，一般是前端的表单数据，与对应表字段对应
  "yobj": {
  },
  //系统参数
  "sys": {
    //请求时清除缓存，默认false，重新加载对象、字段等信息
    "clearCache": false,
    //已找到记录，传入主键是否能查询到对应的记录
    "yzdjl": false
  },
  //分页对象
  "page": {
    //是否进行总数统计
    "totalRequired": true,
    //是否进行列表查询
    "listRequired": true,
    //查询页号
    "pageNumber": 1,
    //页大小
    "pageSize": 10
  }
}