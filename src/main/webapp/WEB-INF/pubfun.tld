<?xml version="1.0" encoding="UTF-8"?>
<taglib version="2.0" xmlns="http://java.sun.com/xml/ns/j2ee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd">
	<tlib-version>1.0</tlib-version>
	<short-name>pubfun</short-name>
	<!-- 定义该标签库的URI -->
	<!--  
	<uri>http://www.gooddemo.net/pubfun</uri>-->
	<!-- 映射通用函数为EL表达式所用 -->	
	<function>
		<name>getUUIDUpperStr</name>
		<function-class>cn.benma666.myutils.StringUtil</function-class>
		<function-signature>java.lang.String getUUIDUpperStr()</function-signature>
	</function>
	<function>
		<name>getSimpleSpell</name>
		<function-class>cn.benma666.myutils.StringUtil</function-class>
		<function-signature>java.lang.String getSimpleSpell(java.lang.String)</function-signature>
	</function>
	<function>
		<name>doFormatDate</name>
		<function-class>cn.benma666.myutils.DateUtil</function-class>
		<function-signature>java.lang.String doFormatDate(java.util.Date, java.lang.String)</function-signature>
	</function>
	<function>
		<name>getDateTimeStr</name>
		<function-class>cn.benma666.myutils.DateUtil</function-class>
		<function-signature>java.lang.String getDateTimeStr(java.lang.String)</function-signature>
	</function>
		
</taglib>
